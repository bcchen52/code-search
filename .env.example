# Copy to .env. Secrets belong only here: never in configs, hashes, or traces.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=            # hosted embeddings only
JUDGE_API_KEY=             # the evaluation judge's provider

CQA_DATA_DIR=./data
CQA_CONFIG=configs/base.yaml

# Serving guardrails
CQA_RATE_LIMIT_PER_MIN=10
CQA_DAILY_SPEND_CAP_USD=1      # demo only; with eval, about $40 a month in all
CQA_REPO_ALLOWLIST=        # comma-separated https repository URLs; empty allows any https repository
